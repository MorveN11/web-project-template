# Git
.git
.gitignore
.gitattributes
.github

# Node — deps are installed inside the image, never copy host's
node_modules
**/node_modules
.pnpm-store

# Build outputs — rebuilt inside the image
dist
**/dist
.next
**/.next
.turbo
coverage
**/coverage
*.tsbuildinfo

# Env files — secrets come via compose/build args, not the build context
.env
.env.*
!.env.example

# Compose / docker metadata — never needed inside the image
docker-compose*.yml
Dockerfile*
**/Dockerfile*

# Local infra (bind mounts live on the host, not in the image)
.containers

# Docs / screenshots / IDE noise
docs
screenshots
README.md
CONTRIBUTING.md
AGENTS.md
.vscode
.idea
*.log
.DS_Store

# Claude + agents tooling — never needed inside the image
# (skill caches, agent skills, skill metadata — not part of the app)
.claude
.agents

# Tooling configs — never used at build or runtime
# (lint/format/release metadata, editor settings, skills lockfile)
biome.json
.editorconfig
release.config.mjs
skills-lock.json

# Husky / git hooks — never run inside the image
.husky