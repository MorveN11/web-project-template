// Prisma 7: `datasource.url` is no longer supported in schema files.
// Connection URLs for Migrate live in `prisma.config.ts`. The runtime
// PrismaClient is built with a driver adapter (see src/client.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// Enums
// =============================================================================

/// Role del User. Mirrors Clerk publicMetadata.role.
enum Role {
  ADMIN
  CLIENT
}

/// Línea de producto. 12 Profesional + 15 Sport = 27 categorías (real: 23
/// en research/productos.md — el comment queda en 27 por compatibilidad
/// con PLAN.md v1; ajustar si el seed real diverge).
enum TipoProducto {
  PROFESIONAL
  SPORT
}

/// Estados del Pedido. Flujo: PENDIENTE → PAGADO → ENVIADO → ENTREGADO.
enum EstadoPedido {
  PENDIENTE
  PAGADO
  ENVIADO
  ENTREGADO
  CANCELADO
}

/// Estado del pago (TBD con pasarela).
enum EstadoPago {
  PENDIENTE
  PAGADO
  FALLIDO
  REEMBOLSADO
}

/// Estado del envío.
enum EstadoEnvio {
  PREPARACION
  EN_TRANSITO
  ENTREGADO
  DEVUELTO
}

/// Tipos de movimiento de stock. Append-only ledger.
enum MovimientoTipo {
  INGRESO
  EGRESO
  AJUSTE
  DEVOLUCION
}

/// Estados de una cotización B2B.
enum CotizacionEstado {
  NUEVA
  EN_REVISION
  COTIZADA
  ACEPTADA
  RECHAZADA
}

// =============================================================================
// Identidad
// =============================================================================

/// User local. Clerk es la fuente de verdad; este row es un cache.
/// El api sincroniza via webhook user.created/user.updated.
model User {
  id        String    @id @default(cuid())
  clerkId   String    @unique @db.VarChar(64)
  email     String    @unique @db.VarChar(255)
  firstName String    @db.VarChar(80)
  lastName  String    @db.VarChar(80)
  imageUrl  String?   @db.VarChar(500)
  role      Role      @default(CLIENT)
  /// Ley 164 — el usuario debe consentir explícitamente antes de recibir
  /// marketing. Default false. Toggle desde UserProfile.
  consentimientoMarketing Boolean @default(false)
  consentimientoDatos     Boolean @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  carritos          Carrito[]
  pedidos           Pedido[]
  direcciones       DireccionEnvio[]
  contactoMensajes  ContactoMensaje[]
  cotizaciones      Cotizacion[]
  newsletter        NewsletterSuscriptor?

  @@index([clerkId])
  @@index([email])
  @@index([deletedAt])
  @@map("users")
}

// =============================================================================
// Catálogo
// =============================================================================

/// Categoría del catálogo. 12 Profesional + 15 Sport, jerarquía plana.
model Categoria {
  id          String       @id @default(cuid())
  slug        String       @unique @db.VarChar(120)
  nombre      String       @db.VarChar(80)
  descripcion String       @db.VarChar(500)
  tipo        TipoProducto
  /// Orden de display dentro de la línea (0 = primero).
  orden       Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  productos Producto[]

  @@index([tipo, orden])
  @@index([deletedAt])
  @@map("categorias")
}

/// Producto del catálogo Petzl. precioBbs en centavos de BOB.
model Producto {
  id            String    @id @default(cuid())
  slug          String    @unique @db.VarChar(120)
  nombre        String    @db.VarChar(160)
  /// 1:1 con Categoria por simplicidad. Si necesitamos M:N, migramos a
  /// `ProductoCategoria` sin romper nada.
  categoriaId  String
  categoria    Categoria @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  tipo          TipoProducto
  descripcionCorta String   @db.VarChar(280)
  descripcion   String    @db.Text
  /// Precio en centavos de BOB (1 BOB = 100).
  precioBbs     Int
  /// Precio anterior (tachado) cuando hay oferta. Centavos BOB.
  precioAnteriorBbs Int?
  referencia    String?   @db.VarChar(40)
  pesoGr        Int?      /// gramos
  material      String?   @db.VarChar(160)
  certificacion String?   @db.VarChar(160)
  destacado     Boolean   @default(false)
  /// true cuando se discontinúa pero se mantiene visible para SEO.
  activo        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  imagenes      ImagenProducto[]
  stocks        Stock[]
  lineasCarrito LineaCarrito[]
  lineasPedido  LineaPedido[]
  cotizacionItems CotizacionItem[]

  @@index([categoriaId, activo, deletedAt])
  @@index([tipo, destacado, deletedAt])
  @@index([slug])
  @@index([deletedAt])
  @@map("productos")
}

/// Imagen de la galería de un producto.
///
/// Las imágenes se almacenan en un provider externo (Cloudinary por
/// defecto). El `publicId` es el identificador único en el provider;
/// el `url` se construye en el api a partir de `publicId` + la env
/// `CLOUDINARY_CLOUD_NAME` para mantener el modelo provider-agnóstico.
///
/// Si en el futuro cambia el provider, `provider` permite discriminar
/// entre Cloudinary, S3, etc. y tener helpers distintos por fuente.
model ImagenProducto {
  id         String   @id @default(cuid())
  productoId String
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  /// ID único del asset en el provider externo (Cloudinary por defecto).
  /// Forma típica: `chacanos/productos/<slug>-<n>`. Requerido si
  /// `provider` es cloudinary.
  publicId   String   @db.VarChar(255)
  /// Provider de almacenamiento. Default: cloudinary.
  provider    String   @default("cloudinary") @db.VarChar(40)
  /// URL canónica completa (CDN + transformaciones por defecto). Opcional
  /// — si es null, el api la construye on-the-fly con `publicId`.
  url         String?  @db.VarChar(500)
  /// Ancho en píxeles (para responsive `srcset`).
  width       Int?
  /// Alto en píxeles.
  height      Int?
  /// MIME type detectado (image/jpeg, image/webp, etc).
  mimeType    String?  @db.VarChar(40)
  /// Peso en bytes (para mostrar en admin).
  bytes       Int?
  alt         String?  @db.VarChar(200)
  /// 0 = principal (la que va en card y hero).
  orden       Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([productoId, orden])
  @@index([publicId])
  @@map("imagenes_producto")
}

// =============================================================================
// Stock e inventario
// =============================================================================

/// Stock por (producto, ubicación). Una fila por combinación.
model Stock {
  id         String   @id @default(cuid())
  productoId String
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  /// Hoy solo 'SANTA_CRUZ'. Multi-warehouse futuro.
  ubicacion   String   @db.VarChar(40)
  cantidad    Int      @default(0)
  /// Stock de seguridad — alerta si cantidad <= minimo.
  minimo      Int      @default(0)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  movimientos MovimientoStock[]

  @@unique([productoId, ubicacion])
  @@index([productoId])
  @@map("stocks")
}

/// Log append-only de cambios de stock. Audit trail.
model MovimientoStock {
  id         String         @id @default(cuid())
  stockId    String
  stock      Stock          @relation(fields: [stockId], references: [id], onDelete: Cascade)
  tipo       MovimientoTipo
  /// Positivo = ingreso, negativo = egreso. Ej: -3 (vendido) o +12 (recibido).
  cantidad   Int
  /// Stock resultante después del movimiento (snapshot).
  stockResultante Int
  /// Referencia libre: id de pedido, nota de proveedor, etc.
  referencia  String?        @db.VarChar(80)
  createdAt   DateTime       @default(now())

  @@index([stockId, createdAt])
  @@map("movimientos_stock")
}

// =============================================================================
// Carrito y pedidos
// =============================================================================

/// Carrito anónimo o persistido. sessionId = cookie HttpOnly; cuando el User
/// hace login, se hace merge con su carrito previo (no modelado en v1).
model Carrito {
  id         String   @id @default(cuid())
  /// Null si es carrito anónimo (solo sessionId).
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Cookie HttpOnly. Único por sesión. Si el User hace login, este sessionId
  /// se mantiene y el carrito se asocia vía userId.
  sessionId  String   @unique @db.VarChar(64)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  /// Cuando se confirma el pedido, el carrito se marca como inactivo (soft).
  activo     Boolean  @default(true)
  pedidoId   String?  @unique
  pedido     Pedido?  @relation(fields: [pedidoId], references: [id])

  lineas LineaCarrito[]

  @@index([userId, activo])
  @@index([sessionId])
  @@map("carritos")
}

model LineaCarrito {
  id         String   @id @default(cuid())
  carritoId  String
  carrito    Carrito  @relation(fields: [carritoId], references: [id], onDelete: Cascade)
  productoId String
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Restrict)
  /// Precio al momento de agregar al carrito (no necesariamente el actual).
  precioBbs  Int
  cantidad   Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([carritoId, productoId])
  @@index([carritoId])
  @@map("lineas_carrito")
}

/// Pedido confirmado. Datos del cliente y dirección se desnormalizan en
/// el momento de checkout (no se borran si el User actualiza su perfil).
model Pedido {
  id              String   @id @default(cuid())
  /// Número legible (ej. CH-2026-00001) generado en el api con sequence.
  numeroPedido    String   @unique @db.VarChar(20)
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Snapshot del cliente al momento del checkout
  email           String   @db.VarChar(255)
  nombre          String   @db.VarChar(160)
  telefono        String?  @db.VarChar(32)

  // Dirección desnormalizada
  direccionLinea1 String   @db.VarChar(200)
  direccionLinea2 String?  @db.VarChar(200)
  ciudad          String   @db.VarChar(80)
  departamento     String   @db.VarChar(40)
  referencia      String?  @db.VarChar(200)

  estado          EstadoPedido  @default(PENDIENTE)
  estadoPago      EstadoPago    @default(PENDIENTE)
  estadoEnvio     EstadoEnvio   @default(PREPARACION)

  /// Total en centavos BOB (suma de lineas).
  subtotalBbs     Int
  /// Costo de envío en centavos BOB (0 si no aplica).
  envioBbs        Int          @default(0)
  /// Total final en centavos BOB = subtotal + envio.
  totalBbs        Int

  /// Notas del cliente al hacer checkout.
  notas           String?  @db.Text
  /// Metadata libre (jsonb futuro para pasarela, etc).
  metadata        Json?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  lineas      LineaPedido[]
  pagos       Pago[]
  envios      Envio[]
  carritos    Carrito[]

  @@index([userId, createdAt])
  @@index([estado, createdAt])
  @@index([estadoPago])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("pedidos")
}

model LineaPedido {
  id              String   @id @default(cuid())
  pedidoId        String
  pedido          Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  productoId      String
  producto        Producto @relation(fields: [productoId], references: [id], onDelete: Restrict)
  /// Snapshot del producto al checkout (no cambia si después se renombra).
  nombreProducto  String   @db.VarChar(160)
  referenciaSKU   String?  @db.VarChar(40)
  /// Precio unitario en centavos BOB al momento de checkout.
  precioUnitarioBbs Int
  cantidad        Int
  /// subtotal = precioUnitarioBbs * cantidad, congelado.
  subtotalBbs     Int

  @@unique([pedidoId, productoId])
  @@index([pedidoId])
  @@index([productoId])
  @@map("lineas_pedido")
}

/// Pago del pedido (TBD con pasarela). Una fila por intento/registro.
model Pago {
  id            String     @id @default(cuid())
  pedidoId      String
  pedido        Pedido     @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  /// 'wompi', 'stripe', 'manual_transfer', etc. — definido por la pasarela.
  pasarela      String     @db.VarChar(40)
  /// ID de la transacción en la pasarela.
  pasarelaTxnId  String?    @db.VarChar(120)
  montoBbs       Int
  estado        EstadoPago @default(PENDIENTE)
  /// Respuesta cruda de la pasarela para auditoría.
  pasarelaResponse Json?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([pedidoId])
  @@index([pasarelaTxnId])
  @@map("pagos")
}

/// Envío del pedido (TBD con courier).
model Envio {
  id            String      @id @default(cuid())
  pedidoId      String
  pedido        Pedido      @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  /// 'agencia_bolivia', 'tigo', 'local', etc. — definido por la pasarela.
  courier       String      @db.VarChar(40)
  /// Número de tracking del courier.
  tracking      String?     @db.VarChar(80)
  estado        EstadoEnvio @default(PREPARACION)
  /// Eventos del envío (manifest, in_transit, delivered, etc).
  eventos       Json?
  /// Estimado de entrega.
  estimadoEntrega DateTime?
  entregadoAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([pedidoId])
  @@index([tracking])
  @@map("envios")
}

// =============================================================================
// Direcciones de envío
// =============================================================================

/// Departamentos de Bolivia. Catálogo fijo, seed inicial.
model Departamento {
  id        String   @id @default(cuid())
  /// Slug estable: 'la-paz', 'santa-cruz', etc.
  slug      String   @unique @db.VarChar(40)
  nombre    String   @db.VarChar(80)
  /// Capital del departamento (para select UI).
  capital   String   @db.VarChar(80)
  /// Orden de display.
  orden     Int      @default(0)
  activo    Boolean  @default(true)

  direcciones DireccionEnvio[]

  @@index([orden])
  @@map("departamentos")
}

model DireccionEnvio {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  departamentoId String
  departamento   Departamento @relation(fields: [departamentoId], references: [id], onDelete: Restrict)
  linea1        String      @db.VarChar(200)
  linea2        String?     @db.VarChar(200)
  ciudad        String      @db.VarChar(80)
  /// Nombre del destinatario si es distinto al del User.
  destinatario  String?     @db.VarChar(160)
  telefono      String?     @db.VarChar(32)
  referencias   String?     @db.VarChar(200)
  /// Una sola dirección puede ser default por User.
  isDefault     Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?

  @@index([userId, isDefault])
  @@index([userId, deletedAt])
  @@map("direcciones_envio")
}

// =============================================================================
// Formularios y marketing
// =============================================================================

/// Submits del formulario de contacto. Inbox del admin.
model ContactoMensaje {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  nombre     String   @db.VarChar(160)
  email      String   @db.VarChar(255)
  empresa    String?  @db.VarChar(160)
  telefono   String?  @db.VarChar(32)
  mensaje    String   @db.Text
  /// Si true, el admin ya lo leyó (oculto del inbox).
  leido      Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([leido, createdAt])
  @@index([email])
  @@map("contacto_mensajes")
}

/// Emails capturados del newsletter (footer del sitio).
model NewsletterSuscriptor {
  id        String   @id @default(cuid())
  /// Null si se subscribe sin estar logueado.
  userId    String?  @unique
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email     String   @unique @db.VarChar(255)
  /// Token de unsubscribe (UUID generado en el api).
  unsubscribeToken String @unique @db.VarChar(64)
  confirmado Boolean  @default(false)
  confirmadoAt DateTime?
  createdAt  DateTime @default(now())
  deletedAt  DateTime?

  @@index([confirmado, createdAt])
  @@index([email])
  @@map("newsletter_suscriptores")
}

// =============================================================================
// Cotizaciones B2B
// =============================================================================

/// Cotización para clientes B2B (caso Petzl volumen, empresas, etc).
model Cotizacion {
  id            String          @id @default(cuid())
  userId        String?
  user          User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Datos de contacto del solicitante (puede no estar registrado).
  nombre        String          @db.VarChar(160)
  email         String          @db.VarChar(255)
  telefono      String?         @db.VarChar(32)
  empresa       String?         @db.VarChar(160)
  /// Lo que el cliente busca (texto libre).
  requerimiento String          @db.Text
  estado        CotizacionEstado @default(NUEVA)
  /// Respuesta del admin (precio ofertado, plazo, etc).
  respuesta     String?         @db.Text
  /// Total ofertado en centavos BOB (si el admin ya respondió).
  totalBbs      Int?
  /// Válida hasta (después se marca como vencida).
  validaHasta   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  items CotizacionItem[]

  @@index([estado, createdAt])
  @@index([email])
  @@map("cotizaciones")
}

model CotizacionItem {
  id            String     @id @default(cuid())
  cotizacionId   String
  cotizacion     Cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)
  productoId     String
  producto       Producto   @relation(fields: [productoId], references: [id], onDelete: Restrict)
  cantidad       Int
  /// Precio unitario ofertado en centavos BOB.
  precioUnitarioBbs Int
  notas          String?    @db.VarChar(500)

  @@index([cotizacionId])
  @@map("cotizacion_items")
}
