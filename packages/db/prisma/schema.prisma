// Prisma 7: `datasource.url` is no longer supported in schema files.
// Connection URLs for Migrate live in `prisma.config.ts`. The runtime
// PrismaClient is built with a driver adapter (see src/client.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// Core
// -----------------------------------------------------------------------------

model User {
  id        String    @id @default(cuid())
  clerkId   String    @unique
  email     String    @unique
  // firstName / lastName are required — Clerk enforces them at
  // signup (Google sign-in ships them by default), and the api's
  // createUserBodySchema validates them. imageUrl is optional;
  // Clerk sends it on every user.updated webhook when the user
  // changes their avatar.
  firstName String
  lastName  String
  imageUrl  String?
  role      Role      @default(CLIENT)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([clerkId])
  @@map("users")
}

// Two roles: ADMIN (full access, can create users via the api) and
// CLIENT (default for self-signup via Clerk). Mirrors the value the
// web app stores under Clerk `publicMetadata.role`.
enum Role {
  ADMIN
  CLIENT
}
