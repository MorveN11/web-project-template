# Prisma connection. Consumed by prisma.config.ts (migrate) and the
# runtime PrismaClient driver adapter. Mirrors apps/api/.env DATABASE_URL.

DATABASE_URL=postgresql://postgres:postgres@localhost:5440/web_project_template?schema=public
# Direct (non-pooler) endpoint. Required for Neon migrations because
# the pooler rejects DDL transactions. Leave empty for docker dev —
# `prisma.config.ts` falls back to DATABASE_URL.

DIRECT_URL=