# Drives BOTH `docker compose up` (postgres only) and
# `docker compose -f docker-compose.prod.yml up --build` (full stack).
#
# Single source of truth for shared infrastructure values. Each app
# also reads its own apps/<name>/.env (Next.js / tsx load from cwd).
# This file is a union of: apps/api/.env.example + apps/web/.env.example
# + compose-only vars (POSTGRES_*, image names, host ports).

# ---------- api runtime (mirrors apps/api/src/env.ts) ----------
NODE_ENV=development
LOG_LEVEL=debug
LOG_QUERIES=true
CORS_ORIGIN=http://localhost:3000

# ---------- api + web clerk (mirrors apps/{api,web}/.env.example) ----------
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_AUTHORIZED_PARTIES=http://localhost:3000,http://localhost:4000
CLERK_WEBHOOK_SIGNING_SECRET=whsec_replace_me
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/auth/iniciar-sesion
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/auth/registro

# ----------------- client-side (mirrors apps/web/src/lib/env/client.ts) ----------
NEXT_PUBLIC_LOG_LEVEL=warn

# ---------- boot-time seed ----------
# When `true`, `packages/db/prisma/seed.ts` runs at api container boot
# and creates `admin@template.test` (ADMIN) on an empty DB. Default `true`
# — every fresh deployment gets a known-good account to validate the
# sign-in / read pipeline. Flip to `false` to disable.
SEED_ENABLED=true

# ---------- postgres (compose dev maps host port; prod compose internal-only) ----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=web_project_template
POSTGRES_HOST_PORT=5440

# ---------- database (api runtime) ----------
# Pooled connection the api uses at runtime (PrismaClient driver adapter).
# Default points at the local docker postgres; override for Neon with
# the `-pooler` endpoint. apps/api/.env.example has the same value.
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/web_project_template?schema=public
# Direct (non-pooler) connection used by `prisma migrate` only. Required
# for Neon because the pooler rejects DDL transactions. Leave empty for
# docker dev (fallback to DATABASE_URL via prisma.config.js).
DIRECT_URL=

# ---------- redis (compose dev maps host port; prod compose internal-only) ----------
REDIS_HOST_PORT=6379

# ---------- web ----------
WEB_HOST_PORT=3000
# NEXT_PUBLIC_API_URL is intentionally NOT here. Docker compose
# hardcodes it to `http://api:8080` (in-container) at web build time.
# Local `pnpm dev:web` falls back to the default in
# apps/web/src/lib/env/client.ts (`http://localhost:4000`). Override
# in apps/web/.env only if your local api runs on a different port.

# ---------- api host port (prod compose maps to container :8080) ----------
API_HOST_PORT=4000

# ---------- compose.prod.yml image names ----------
API_IMAGE=web-project-template-api:local
WEB_IMAGE=web-project-template-web:local
