# Frontend env. Validated at boot by src/lib/env/{client,server}.ts via
# @t3-oss/env-nextjs. Public vars go in env/client.ts (NEXT_PUBLIC_*),
# secrets go in env/server.ts.
#
# Order matches apps/web/.env — keep both in sync.

# Client (NEXT_PUBLIC_*)
# NEXT_PUBLIC_API_URL: see the default in src/lib/env/client.ts. Override
# here only if your local api runs on a port other than 4000.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/auth/iniciar-sesion
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/auth/registro

# Public site URL — used for metadataBase, OG, sitemap, manifest id.
# Override per-env via Dokploy build args. Default in env/client.ts is
# https://example.com — replace with your real production hostname.
NEXT_PUBLIC_SITE_URL=https://example.com

# Client-side log level. Inlined into the JS bundle at build time,
# so changes require a rebuild. Levels: debug < info < warn < error.
# Default: warn in prod (env/client.ts), debug in dev.
NEXT_PUBLIC_LOG_LEVEL=warn

# Server (validated by src/lib/env/server.ts)
NODE_ENV=development
CLERK_SECRET_KEY=sk_test_replace_me
# Build-time flag read by `next.config.ts` to widen CSP `connect-src`
# for `localhost:*`. Defaults true in `.env.example` because local dev
# runs the api on the host (localhost:4000); set false only in
# deployed envs where the api lives on its own subdomain. See
# `.github/SECRETS.md` for the full rule.
IS_COMPOSE=true

# ---------- error monitoring (GlitchTip / Sentry-compatible) ----------
# DEPLOYED ENVS ONLY — leave every key empty (or commented out) in
# local development. Each sentry.{client,server,edge}.config.ts has
# a hard NODE_ENV gate: when `NODE_ENV=development`, Sentry.init is
# skipped regardless of whether NEXT_PUBLIC_SENTRY_DSN is set, so dev
# NEVER tracks even if a stray DSN leaks from testing config.
#
# Activate only on the deployed envs (testing / production). Set
# these via Dokploy env injection or host `.env`, NOT via `.env.example`
# defaults. Empty defaults here = safe local default.
#
# Sentry SDK loads from sentry.{client,server,edge}.config.ts via
# `withSentryConfig` in next.config.ts. The browser SDK POSTs to
# `/api/glitchtip-tunnel` (App Router handler) which forwards to
# the GlitchTip envelope endpoint.
#
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.01
# Build-time only — GlitchTip project SLUG. Forwarded to
# `@sentry/cli --project` for source-map uploads. Set via the release
# workflow from `vars.SENTRY_PROJECT_WEB_{PROD,TEST}`; never edit here
# unless you know the project slug (find it in GlitchTip UI → Settings
# → Projects → click project → URL segment after `/projects/`).
# NEXT_PUBLIC_SENTRY_PROJECT=
# Build-time only — GlitchTip base URL. Forwarded to
# `@sentry/cli --url` for source-map uploads. Set via the release
# workflow from `vars.SENTRY_URL`.
# NEXT_PUBLIC_SENTRY_URL=https://glitchtip.example.com
# Build-time only (source map upload). NEVER set this in the container's
# runtime env — it would leak via `docker history`.
# SENTRY_AUTH_TOKEN=

# ---------- analytics (Umami) ----------
# DEPLOYED ENVS ONLY — leave every key empty (or commented out) in
# local development. The <UmamiScript /> component has a hard NODE_ENV
# gate: when NODE_ENV=development, no script tag renders. The values
# are irrelevant to the gate, so even a stray URL from testing config
# cannot fire requests from a dev build.
#
# Single website-id, per-env override via Dokploy build args. Activate
# only on deployed envs (testing / production). Empty defaults = safe
# local default.
#
# NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://your-umami.example.com/script.js
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=your-website-id
