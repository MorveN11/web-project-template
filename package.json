{
  "name": "web-project-template",
  "private": true,
  "version": "1.0.0",
  "description": "Minimal web project template. Hono + Prisma + Postgres API, Next.js + shadcn + Clerk web, pnpm workspaces. Extend with features as the project grows.",
  "license": "MIT",
  "author": "Jose Manuel Morales Patty",
  "repository": {
    "type": "git",
    "url": "https://github.com/MorveN11/web-project-template"
  },
  "homepage": "https://github.com/MorveN11/web-project-template#readme",
  "bugs": {
    "url": "https://github.com/MorveN11/web-project-template/issues"
  },
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.5.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "compose": "docker compose --env-file .env up -d",
    "down": "docker compose --env-file .env down",
    "compose:prod": "docker compose -f docker-compose.prod.yml --env-file .env up -d --build",
    "down:prod": "docker compose -f docker-compose.prod.yml --env-file .env down",
    "dev:api": "pnpm --filter @app/api dev",
    "dev:web": "pnpm --filter @app/web dev",
    "dev": "pnpm --parallel --filter @app/api --filter @app/web run dev",
    "build:packages": "pnpm --filter @app/shared-types --filter @app/db build",
    "build": "pnpm --recursive --workspace-concurrency=4 run build",
    "lint": "pnpm --recursive run lint",
    "lint:fix": "pnpm --recursive run lint:fix",
    "format": "pnpm --recursive run format",
    "check": "pnpm --recursive run check",
    "typecheck": "pnpm build:packages && pnpm --recursive run typecheck",
    "test": "pnpm build:packages && pnpm --recursive run test",
    "db:generate": "pnpm --filter @app/db generate",
    "db:migrate:dev": "pnpm --filter @app/db migrate:dev",
    "db:migrate:deploy": "pnpm --filter @app/db migrate:deploy",
    "db:migrate:reset": "pnpm --filter @app/db migrate:reset",
    "db:studio": "pnpm --filter @app/db studio",
    "db:seed": "pnpm --filter @app/api build && node --env-file=apps/api/.env apps/api/dist/seed.cjs"
  }
}
