{
  "name": "@app/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps dist/index.js",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome check --write .",
    "check": "biome check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "pnpm --filter @app/db generate",
    "db:migrate:dev": "pnpm --filter @app/db migrate:dev",
    "db:migrate:deploy": "pnpm --filter @app/db migrate:deploy",
    "db:studio": "pnpm --filter @app/db studio",
    "seed": "pnpm --filter @app/db seed",
    "postinstall": "pnpm --filter @app/db generate"
  },
  "dependencies": {
    "@app/db": "workspace:*",
    "@hono/node-server": "^2.0.8",
    "@hono/zod-validator": "^0.8.0",
    "hono": "^4.12.28",
    "jose": "^6.2.3",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@types/node": "^26.1.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
