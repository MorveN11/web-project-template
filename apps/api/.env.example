# Backend-specific env. Loaded by tsx (dev) or by docker-entrypoint.sh (prod).
# Validated at boot by src/env.ts via zod. Anything missing fails fast.

NODE_ENV=development
PORT=4000

# pino level: trace|debug|info|warn|error|fatal
LOG_LEVEL=debug
# true → emit every Prisma query + params + duration
LOG_QUERIES=false

# Postgres connection. Matches docker-compose.yml (dev) and the api service in compose.prod.yml.
DATABASE_URL=postgresql://postgres:postgres@localhost:5440/web_project_template?schema=public

# CORS — comma separated via zod transform.
CORS_ORIGIN=http://localhost:3000

# Clerk (shared with apps/web).
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_AUTHORIZED_PARTIES=http://localhost:3000,http://localhost:4000

# Optional: enable the idempotent seed script at container startup.
SEED_ENABLED=false