# Backend-specific env. Loaded by tsx (dev) or by docker-entrypoint.sh (prod).
# Validated at boot by src/env.ts via zod. Anything missing fails fast.
#
# Order matches apps/api/.env — keep both in sync. Mirrors the declaration
# order in src/env.ts so each var's section comment lines up with its schema.

# Runtime
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
LOG_QUERIES=true

# Storage
DATABASE_URL=postgresql://postgres:postgres@localhost:5440/web_project_template?schema=public
# Direct (non-pooler) postgres URL. Required for Neon so `prisma migrate`
# hits a non-pooler endpoint; the pooler rejects DDL transactions. Leave
# empty for docker dev — `packages/db/prisma.config.js` falls back to
# DATABASE_URL when DIRECT_URL is unset.
DIRECT_URL=
REDIS_URL=redis://localhost:6379

# HTTP
CORS_ORIGIN=http://localhost:3000

# Clerk (also consumed by apps/web via NEXT_PUBLIC_*)
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_AUTHORIZED_PARTIES=http://localhost:3000,http://localhost:4000

# Clerk webhook signing secret (Clerk dashboard → Webhooks → endpoint).
# Replace with the value from your Clerk dashboard once the endpoint
# is configured. Required for the /webhooks/clerk route to verify
# inbound events.
CLERK_WEBHOOK_SIGNING_SECRET=whsec_replace_me

# ---------- boot-time seed ----------
# When `true`, `packages/db/prisma/seed.ts` runs at api container boot
# and creates `admin@template.test` (ADMIN) on an empty DB. Default `true`
# — every fresh deployment gets a known-good account to validate the
# sign-in / read pipeline. Flip to `false` to disable.
SEED_ENABLED=true
