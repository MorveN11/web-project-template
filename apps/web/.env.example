# Frontend env. Validated at boot by src/lib/env/{client,server}.ts via
# @t3-oss/env-nextjs. Public vars go in env/client.ts (NEXT_PUBLIC_*),
# secrets go in env/server.ts.
#
# Order matches apps/web/.env — keep both in sync.

# Client (NEXT_PUBLIC_*)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/auth/iniciar-sesion
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/auth/registro
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Server (validated by src/lib/env/server.ts)
NODE_ENV=development
CLERK_SECRET_KEY=sk_test_replace_me